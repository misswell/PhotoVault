# Xcode and local build output
build/
DerivedData/
.asc/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# The marketing site is its own repository (remote `sites`), not part of this
# one. Keeping it ignored stops `git add -A` from recording it as a gitlink.
website/

# AI search model toolchain (tools/models). The raw HF checkpoint is ~1.5 GB and
# the converted mlpackages are ~0.4 GB: both are reproducible from
# tools/models/requirements-lock.txt + convert_siglip2.py, so they stay out of
# git. model_manifest.json IS committed (it is the app's contract).
tools/models/.venv/
tools/models/cache/
tools/models/out/
tools/models/build/
tools/models/__pycache__/

# Local download-asset staging models, populated by
# tools/models/install_models.py. 364 MB for the W8 build; ignored for the same
# reason as tools/models/out/. Shipping builds exclude these resources; users
# may explicitly download the verified model from settings or smart search.
PhotoVault/Models/
